{
    "configurations": [
        
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        }

    ]
}
:root {
  --bg: #0b0a14;
  --panel: #151321;
  --purple: #a78bfa;
  --pink: #f0abfc;
  --text: #f7f4ff;
  --muted: #aaa5bd;
  --border: rgba(193, 167, 255, 0.18);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

.glow {
  position: fixed;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  filter: blur(110px);
  opacity: 0.15;
  pointer-events: none;
  z-index: -1;
}

.glow-one { background: #8b5cf6; top: 10%; left: -130px; }
.glow-two { background: #d946ef; bottom: 5%; right: -130px; }

header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 7%;
  background: rgba(11, 10, 20, 0.94);
  border-bottom: 1px solid var(--border);
}

.logo { font-size: 25px; font-weight: 800; }
.logo span { color: var(--purple); }

nav { display: flex; gap: 22px; }
nav a { color: var(--muted); font-size: 13px; transition: 0.3s; }
nav a:hover, .socials a:hover { color: var(--pink); }

.nav-btn {
  padding: 9px 17px;
  border: 1px solid var(--border);
  border-radius: 30px;
  font-size: 13px;
}

.hero {
  min-height: 86vh;
  padding: 80px 9%;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 45px;
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 7px 13px;
  border: 1px solid var(--border);
  border-radius: 30px;
  color: #d7c8ff;
  font-size: 10px;
  letter-spacing: 1px;
}

.status span {
  width: 7px;
  height: 7px;
  background: #6ee7b7;
  border-radius: 50%;
  box-shadow: 0 0 12px #6ee7b7;
}

.eyebrow {
  color: var(--purple);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 3px;
  margin-bottom: 13px;
}

.hero .eyebrow { margin-top: 28px; }

.hero h1 {
  font-size: clamp(35px, 5vw, 62px);
  line-height: 1.25;
  margin-bottom: 10px;
  overflow-wrap: anywhere;
}

.gradient {
  background: linear-gradient(100deg, #c4b5fd, #f0abfc, #a5b4fc);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero h2 { font-size: clamp(20px, 3vw, 29px); }
#typing { color: #c4b5fd; }

.cursor {
  color: var(--pink);
  animation: blink 0.8s infinite;
}

@keyframes blink { 50% { opacity: 0; } }

.intro {
  color: var(--muted);
  max-width: 530px;
  margin-top: 18px;
  font-size: 14px;
}

.hero-buttons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }

.btn {
  display: inline-block;
  padding: 12px 21px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
  transition: transform 0.25s, box-shadow 0.25s;
}

.btn:hover { transform: translateY(-4px); }

.primary {
  background: linear-gradient(110deg, #a78bfa, #e9a8fc);
  color: #161020;
  box-shadow: 0 8px 28px rgba(167, 139, 250, 0.17);
}

.secondary { border: 1px solid var(--border); }

.socials { display: flex; gap: 23px; margin-top: 28px; font-size: 13px; }
.socials a { color: var(--muted); transition: 0.3s; }

.profile-area {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 390px;
}

.profile-circle {
  width: 240px;
  height: 240px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(140deg, #b8a0ff, #4c347a 55%, #21152f);
  border: 1px solid rgba(255,255,255,0.3);
  box-shadow: 0 0 75px rgba(167, 139, 250, 0.23);
  animation: float 4s ease-in-out infinite;
}

.profile-initials {
  font-size: 83px;
  font-weight: 800;
  color: white;
  text-shadow: 0 5px 30px #2a174b;
}

.orbit {
  position: absolute;
  border: 1px solid rgba(196,181,253,0.25);
  border-radius: 50%;
  animation: spin 18s linear infinite;
}

.orbit-one { width: 315px; height: 315px; }
.orbit-two { width: 370px; height: 370px; border-style: dashed; animation-direction: reverse; }

.floating-card {
  position: absolute;
  padding: 12px 16px;
  border: 1px solid var(--border);
  background: #181428;
  border-radius: 12px;
  font-size: 12px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
}

.card-top { top: 50px; right: 0; }
.card-bottom { bottom: 50px; left: 0; }

@keyframes float { 50% { transform: translateY(-12px); } }
@keyframes spin { to { transform: rotate(360deg); } }

.section { padding: 90px 9%; text-align: center; }
.section h2 { font-size: clamp(29px, 4vw, 42px); margin-bottom: 13px; }
.section-desc { color: var(--muted); font-size: 13px; margin-bottom: 35px; }

.about-card {
  display: flex;
  gap: 25px;
  max-width: 850px;
  margin: 30px auto 0;
  padding: 32px;
  text-align: left;
  background: linear-gradient(135deg, #171426, #100e1a);
  border: 1px solid var(--border);
  border-radius: 20px;
}

.about-symbol {
  min-width: 60px;
  height: 60px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: rgba(167,139,250,0.13);
  color: var(--pink);
  font-size: 35px;
}

.about-card h3 { margin-bottom: 13px; font-size: 19px; }
.about-card p { color: var(--muted); font-size: 13px; margin-top: 10px; }

.skills-grid {
  max-width: 900px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
  text-align: left;
}

.skill-card {
  padding: 22px;
  border: 1px solid var(--border);
  background: var(--panel);
  border-radius: 15px;
  transition: 0.3s;
}

.skill-card:hover { transform: translateY(-5px); border-color: #a78bfa; }

.skill-heading {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 16px;
  font-size: 13px;
}

.skill-heading span:last-child { color: var(--muted); font-size: 10px; }

.skill-track { height: 6px; border-radius: 20px; background: #29243a; overflow: hidden; }

.skill-fill {
  height: 100%;
  width: var(--level);
  border-radius: 20px;
  background: linear-gradient(90deg, #8b5cf6, #f0abfc);
  animation: grow 1.4s ease-out both;
}

@keyframes grow { from { width: 0; } }

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  text-align: left;
}

.project-card {
  padding: 27px 22px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: linear-gradient(150deg, #191629, #100e19);
  transition: transform 0.3s, border-color 0.3s;
}

.project-card:hover { transform: translateY(-8px); border-color: #b69cff; }

.project-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  font-size: 28px;
  border-radius: 14px;
  margin-bottom: 22px;
}

.purple { background: #30234c; color: #c4b5fd; }
.blue { background: #1c2f49; color: #93c5fd; }
.pink { background: #43233f; color: #f5b5ee; }

.project-type { font-size: 9px; letter-spacing: 1.3px; color: var(--purple); margin-bottom: 9px; }
.project-card h3 { font-size: 17px; margin-bottom: 10px; }
.project-card > p:not(.project-type) { font-size: 12px; color: var(--muted); min-height: 62px; }

.tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
.tags span { font-size: 10px; padding: 5px 9px; background: #252037; border-radius: 7px; color: #d4c9f5; }

.note { color: #89839c; font-size: 10px; margin-top: 22px; }

.contact { padding-bottom: 110px; }
.contact .section-desc { max-width: 500px; margin: 0 auto 25px; }

footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 25px 7%;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 11px;
}

.back-top { color: #c4b5fd; }

@media (max-width: 900px) {
  header { flex-wrap: wrap; }
  nav { order: 3; width: 100%; justify-content: center; flex-wrap: wrap; gap: 15px; }
  .hero { grid-template-columns: 1fr; text-align: center; padding-top: 65px; }
  .hero .intro { margin-left: auto; margin-right: auto; }
  .hero-buttons, .socials { justify-content: center; }
  .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 560px) {
  header { padding: 16px 5%; }
  .nav-btn { padding: 7px 11px; }
  nav { gap: 12px; }
  nav a { font-size: 11px; }
  .hero { padding: 55px 6%; }
  .profile-circle { width: 185px; height: 185px; }
  .profile-initials { font-size: 65px; }
  .orbit-one { width: 245px; height: 245px; }
  .orbit-two { width: 285px; height: 285px; }
  .profile-area { min-height: 320px; }
  .floating-card { font-size: 10px; padding: 9px 11px; }
  .card-top { top: 20px; }
  .card-bottom { bottom: 20px; }
  .section { padding: 65px 6%; }
  .about-card { padding: 22px; flex-direction: column; }
  .skills-grid, .projects-grid { grid-template-columns: 1fr; }
  footer { flex-direction: column; text-align: center; }
}
